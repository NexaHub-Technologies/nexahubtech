{
  "permissions": {
    "allow": [
      "Artifact",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr status:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr create:*)"
    ],
    "deny": [
      "Bash(gh repo delete:*)",
      "Bash(gh api:*)"
    ]
  }
}
